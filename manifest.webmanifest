{
  "name": "Detector de notas",
  "short_name": "Notas",
  "description": "Detecta las notas musicales de una melodía.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#2f4cff",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/*",
            ".mp3",
            ".m4a",
            ".wav",
            ".ogg",
            ".opus",
            ".aac"
          ]
        }
      ],
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}